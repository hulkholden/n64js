{
  "name": "n64js",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "description": "An JavaScript N64 emulator.",
  "main": "n64.min.js",
  "type": "module",
  "scripts": {
    "test:visual": "node tools/texture_sampler/run.js",
    "build:visual": "bun build tools/texture_sampler/visual.js --outfile=build/texture_sampler_visual.js",
    "lint": "bun --bun eslint src js tools eslint.config.js --max-warnings 0",
    "lint:fix": "bun run lint --fix",
    "build": "bun run tools/build.js",
    "build-debug": "bun run tools/build.js --debug",
    "benchmark": "bun run ./src/headless/benchmark.js",
    "headless": "bun run ./src/headless/headless.js",
    "inventory": "bun run ./src/inventory/inventory.js",
    "inventory-batch": "bun run ./src/inventory/inventory_batch.js",
    "inventory-query": "bun run ./src/inventory/inventory_query.js",
    "inventory-summary": "bun run ./src/inventory/inventory_summary.js",
    "audio-microcode-replay": "bun run ./src/inventory/audio_microcode_replay_cli.js",
    "audio-microcode-catalogue": "bun run ./src/inventory/audio_microcode_catalogue_cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hulkholden/n64js"
  },
  "keywords": [
    "n64",
    "emulator"
  ],
  "author": "Paul Holden",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hulkholden/n64js/issues"
  },
  "homepage": "https://github.com/hulkholden/n64js",
  "dependencies": {
    "lil-gui": "^0.18.2",
    "mitata": "^0.1.14",
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "1.58.2"
  }
}
